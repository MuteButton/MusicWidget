<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <activity android:name=".debug.VisualCalibrationActivity" android:exported="true" android:excludeFromRecents="true" />
        <activity android:name=".debug.IdleReferenceActivity" android:exported="true" android:excludeFromRecents="true" />
        <activity
            android:name=".debug.DebugMediaActivity"
            android:taskAffinity="com.example.mediawidget.debug"
            android:exported="true"
            android:label="Widget media test fixture"
            android:excludeFromRecents="true" />
        <service
            android:name=".debug.DebugMediaService"
            android:process=":debug_media"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name=".debug.DebugMediaReceiver"
            android:process=":debug_media"
            android:exported="true" />
    </application>
</manifest>
