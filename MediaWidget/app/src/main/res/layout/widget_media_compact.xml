<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background_shape" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp">
  <LinearLayout android:id="@+id/idle_state" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/idle_art" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/widget_music_orb" android:contentDescription="@null" android:importantForAccessibility="no" android:padding="15dp" android:src="@drawable/ic_widget_music" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/idle_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:text="@string/widget_idle_title" android:textColor="#FFF9FC" android:textSize="14sp" />
      <TextView android:id="@+id/idle_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="2" android:text="@string/widget_idle_subtitle" android:textColor="#D5DAFF" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/btn_open" android:layout_width="88dp" android:layout_height="48dp" android:background="@drawable/widget_open_button" android:drawableEnd="@drawable/ic_widget_chevron" android:drawablePadding="4dp" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center" android:maxLines="1" android:paddingStart="10dp" android:paddingEnd="8dp" android:text="@string/widget_open_app" android:textColor="#FFF4FF" android:textSize="12sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/media_state" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/album_art" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/widget_album_background" android:clipToOutline="true" android:contentDescription="@string/widget_open_player" android:scaleType="centerCrop" android:src="@drawable/ic_album_placeholder" />
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:orientation="vertical">
          <LinearLayout android:id="@+id/text_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFF9FC" android:textSize="14sp" />
            <TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textColor="#C9BBF3" android:textSize="11sp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="start|center_vertical">
            <ImageButton android:id="@+id/btn_prev" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_secondary_button" android:contentDescription="@string/widget_previous" android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_prev" />
            <ImageButton android:id="@+id/btn_play" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_primary_button" android:contentDescription="@string/widget_play" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_play" />
            <ImageButton android:id="@+id/btn_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_secondary_button" android:contentDescription="@string/widget_next" android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_next" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/progress_container" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="4dp" android:orientation="vertical">
      <ProgressBar android:id="@+id/progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:importantForAccessibility="yes" android:indeterminate="false" android:max="1000" android:maxHeight="4dp" android:minHeight="4dp" android:progressTint="@null" android:progressBackgroundTint="@null" android:progressDrawable="@drawable/widget_progress" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Chronometer android:importantForAccessibility="no" android:id="@+id/elapsed_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="0:00" android:textColor="#DBD8F5" android:textSize="10sp" />
        <Chronometer android:importantForAccessibility="no" android:id="@+id/remaining_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="−0:00" android:textColor="#DBD8F5" android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
