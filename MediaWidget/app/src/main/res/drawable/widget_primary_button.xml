<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient android:angle="45" android:startColor="#BEF8FF" android:centerColor="#A6ABFF" android:endColor="#FFC9FB" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient android:angle="45" android:startColor="#689DF5" android:centerColor="#8C7DE4" android:endColor="#D998EB" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient android:type="radial" android:centerX="0.7" android:centerY="0.2" android:gradientRadius="40dp" android:startColor="#55F5AAFF" android:endColor="#00725CDC" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
