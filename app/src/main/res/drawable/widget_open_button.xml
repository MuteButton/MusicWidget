<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item android:top="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient android:angle="0" android:startColor="#9BBEFF" android:centerColor="#A18AFF" android:endColor="#F5B0F3" />
                </shape>
            </item>
            <item android:left="1dp" android:top="5dp" android:right="1dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="23dp" />
                    <gradient android:angle="0" android:startColor="#4F73CE" android:centerColor="#6048A6" android:endColor="#B970BD" />
                </shape>
            </item>
            <item android:left="2dp" android:top="6dp" android:right="2dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="90" android:startColor="#008877EE" android:endColor="#407F8DFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
